{
  "name": "ttrpg-effects",
  "version": "1.0.0",
  "description": "Desktop tool for TTRPG map effects and session projection.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite electron-vite dev",
    "build": "pnpm typecheck && NODE_OPTIONS=--experimental-sqlite electron-vite build",
    "dist:mac": "pnpm build && electron-builder --mac dmg",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.luismoncaris.ttrpg-effects",
    "productName": "TTRPG Effects",
    "copyright": "Copyright © 2026 Luis Moncaris",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets/logo/ttrpg-effects-logo.png",
        "to": "assets/logo/ttrpg-effects-logo.png"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/logo/ttrpg-effects-logo.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "extendInfo": {
        "LSEnvironment": {
          "NODE_OPTIONS": "--experimental-sqlite"
        }
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.2.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "electron-vite": "^4.0.0",
    "marked": "^18.0.4",
    "pixi.js": "^8.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
