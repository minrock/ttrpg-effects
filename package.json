{
  "name": "ttrpg-effects",
  "version": "3.12.0",
  "description": "Desktop tool for TTRPG map effects and session projection.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite electron-vite dev",
    "build": "pnpm typecheck && NODE_OPTIONS=--experimental-sqlite electron-vite build",
    "dist:mac": "pnpm build && electron-builder --mac dmg",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:api": "pnpm typecheck && vite build --config src/server/vite.config.ts",
    "start:api": "node --env-file-if-exists=.env out/api/index.mjs",
    "dev:api": "pnpm build:api && pnpm start:api",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build:web": "pnpm typecheck && vite build --config src/web/vite.config.ts",
    "dev:service": "node --env-file-if-exists=.env.electron node_modules/electron-vite/bin/electron-vite.js dev",
    "start:service": "node --env-file-if-exists=.env.electron node_modules/electron/cli.js .",
    "setup:env": "bash scripts/setup-env.sh",
    "db:migrate": "node --env-file-if-exists=.env out/api/db-migrate.mjs",
    "test:db": "vitest run --config src/infrastructure/server/database/vitest.config.ts",
    "identity:bootstrap": "node --env-file-if-exists=.env out/api/identity-cli.mjs bootstrap",
    "identity:provision-dm": "node --env-file-if-exists=.env out/api/identity-cli.mjs provision-dm",
    "identity:recover-admin": "node --env-file-if-exists=.env out/api/identity-cli.mjs recover-admin",
    "identity:password": "node --env-file-if-exists=.env out/api/identity-cli.mjs password",
    "test:identity": "vitest run --config src/infrastructure/server/identity/vitest.config.ts",
    "data": "node --env-file-if-exists=.env out/api/data-cli.mjs",
    "test:owned": "vitest run --config src/infrastructure/server/owned/vitest.config.ts",
    "test:invitations": "vitest run --config src/infrastructure/server/invitations/vitest.config.ts",
    "invitations:invalidate": "node --env-file-if-exists=.env out/api/invitation-invalidate.mjs",
    "test:moderation": "vitest run --config src/infrastructure/server/moderation/vitest.config.ts"
  },
  "build": {
    "appId": "com.luismoncaris.ttrpg-effects",
    "productName": "TTRPG Effects",
    "copyright": "Copyright \u00a9 2026 Luis Moncaris",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets/logo/ttrpg-effects-icon.png",
        "to": "assets/logo/ttrpg-effects-icon.png"
      },
      {
        "from": "src/render/three/dice/vendor",
        "to": "licenses/dice-box-threejs",
        "filter": [
          "LICENSE",
          "README.md"
        ]
      },
      {
        "from": "assets/dice/audio",
        "to": "licenses/kenney-casino-audio",
        "filter": [
          "License.txt",
          "README.md"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/logo/ttrpg-effects-icon.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "extendInfo": {
        "LSEnvironment": {
          "NODE_OPTIONS": "--experimental-sqlite"
        }
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "@3d-dice/dice-roller-parser": "0.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-list": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "better-auth": "1.7.14",
    "cannon-es": "0.20.0",
    "dompurify": "^3.4.14",
    "electron-vite": "^4.0.0",
    "honeycomb-grid": "^4.1.5",
    "kysely": "0.29.7",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.4",
    "pg": "8.23.1",
    "pixi.js": "^8.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "three": "0.143.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.143.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "7.3.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
